# PostgreSQL (Neon эсвэл Supabase). Neon дээр "pooled" холболтын URL-ыг ашигла.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Сайтын үндсэн хаяг
NEXT_PUBLIC_SITE_URL=https://tsag.smartuvs.mn

# Нэвтрэх session-ий нууц түлхүүр (32+ тэмдэгт). `openssl rand -base64 32`
SESSION_SECRET=

# SMS: "console" (хөгжүүлэлтэд — терминалд хэвлэнэ) эсвэл гэрээ хийсэн үйлчилгээ үзүүлэгчийн нэр
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Redis (Upstash) — цаг түр түгжих, OTP rate limit. Хоосон бол санах ойд ажиллана (зөвхөн dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Утас баталгаажуулалт: verify.mn (үйлчлүүлэгч 144773 руу код илгээнэ). https://verify.mn → Developer Console
# Хоосон бол dev-д mock горим (5 сек дараа автоматаар баталгаажна). Production-д заавал.
VERIFYMN_API_KEY=
VERIFYMN_API_URL=https://api.verify.mn
