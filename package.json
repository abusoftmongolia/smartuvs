{
  "name": "tsag-smartuvs",
  "version": "0.1.0",
  "private": true,
  "description": "tsag.smartuvs.mn — олон салбарын цаг захиалгын систем (SmartUvs.mn платформын бүтээгдэхүүн)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:constraints": "tsx scripts/apply-sql.ts drizzle/custom/booking_constraints.sql",
    "db:seed": "tsx scripts/seed.ts",
    "admin:grant": "tsx scripts/make-super-admin.ts",
    "db:setup": "npm run db:migrate && npm run db:constraints && npm run db:seed",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "db:deploy": "npm run db:migrate && npm run db:constraints"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
